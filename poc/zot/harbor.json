{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "gc": true,
    "dedupe": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "acme.co/**": {
          "policies": [
            {
              "users": [
                "ci"
              ],
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            },
            {
              "users": [
                "robot-distributor"
              ],
              "actions": [
                "read"
              ]
            }
          ]
        }
      }
    }
  },
  "log": {
    "level": "warn"
  }
}