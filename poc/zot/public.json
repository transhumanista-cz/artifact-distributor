{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "gc": true,
    "dedupe": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [],
          "anonymousPolicy": [
            "read"
          ]
        },
        "acme/**": {
          "policies": [
            {
              "users": [
                "acme-publisher"
              ],
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            }
          ],
          "anonymousPolicy": [
            "read"
          ]
        }
      }
    }
  },
  "log": {
    "level": "warn"
  }
}